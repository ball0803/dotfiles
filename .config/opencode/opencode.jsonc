{
  // "model": "minimax (local)/plezan/MiniMax-M2.1-REAP-50-W4A16",
  "model": "mistral (local)/cyankiwi/Devstral-Small-2-24B-Instruct-2512-AWQ-4bit",
  "provider": {
    "minimax (local)": {
      "name": "minimax (local)",
      "options": {
        "baseURL": "https://inspiration-resolution-allowance-developmental.trycloudflare.com/v1",
        "apiKey": "42caab8d691dbe48cc813792cbef694b60e772f3d85284ef3bf84011bcf6ebb3"
      },
      "models": {
        "plezan/MiniMax-M2.1-REAP-50-W4A16": {
          "name": "plezan/MiniMax-M2.1-REAP-50-W4A16",
        }
      }
    },
    "minimax-coding-plan": {
      "models": {
        "MiniMax-M2.1-lightning": {
          "name": "MiniMax-M2.1-lightning"
        }
      }
    },
    "mistral (local)": {
      "name": "mistral (local)",
      "options": {
        "baseURL": "https://cashiers-cyber-theory-agency.trycloudflare.com/v1",
        "apiKey": "6dd6344298ae89b3c98cc3d45cca50eadaea1b96b6cc95ea38eed41678cb2f62"
      },
      "models": {
        "mistralai/Devstral-Small-2-24B-Instruct-2512": {
          "name": "mistralai/Devstral-Small-2-24B-Instruct-2512",
          "limit": {
            "context": 127264,
            "output": 65536
          }
        },
        "cyankiwi/Devstral-Small-2-24B-Instruct-2512-AWQ-4bit": {
          "name": "Devstral-Small-2-24B-Instruct-2512-AWQ-4bit",
          "limit": {
            "context": 127264,
            "output": 65536
          }
        }
      }
    },
    "qwen": {
      "name": "qwen (local)",
      "options": {
        "baseURL": "https://sides-associate-nuclear-reggae.trycloudflare.com/v1",
        "apiKey": "7ac202b61b308285f7c766d3fc2087399a814c5a305e177027540e4254e8dcd8"
      },
      "models": {
        "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8": {
          "name": "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8",
          "stream": false,
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
  },
  "plugin": [
    "@zenobius/opencode-skillful",
    "oh-my-opencode@latest"
  ],
  "mcp": {
    "puppeteer-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer@latest"
      ],
      "enabled": true,
      "environment": {
        "PUPPETEER_HEADLESS": "true",
        "PUPPETEER_TIMEOUT": "30000"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "CONTEXT_TOKEN_KEY": ""
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "octocode-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "octocode-mcp@latest"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN_KEY}"
      }
    },
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://searxng.internal"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
